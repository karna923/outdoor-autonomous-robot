<!-- WHEEL_BASE: TBD — measure after assembly and add wheel links -->
<!-- 6x wheel links needed: FL, FR, ML, MR, RL, RR -->
<!-- Rocker-bogie suspension means wheel z-positions vary with terrain -->


<?xml version="1.0"?>
<robot name="outdoor_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base dimensions — measure and update these -->
  <xacro:property name="base_length" value="1.27173"/>
  <xacro:property name="base_width" value="0.51881"/>
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="8.5"/>
      <inertia ixx="0.193" ixy="0" ixz="0" iyy="1.144" iyz="0" izz="1.333"/>
    </inertial>
  </link>

  <!-- IMU link -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/> <!--MEASURE: IMU POS ON CHASSIS-->
  </joint>

  <!-- GPS link -->
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/> <!--MEASURE: GPS MAST HEIGHT-->
  </joint>

  <!-- Lidar link -->
  <link name="laser_frame"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.2 0 0.1" rpy="0 0 0"/> <!--MEASURE: LIDAR MOUNT POS-->
  </joint>

</robot>
